# local: in-memory daily cap, sessions started on the `make dev-bot` runner (SmallWebRTC).
# cloud: Upstash daily cap, agents started on Pipecat Cloud.
DEPLOYMENT=local
# Shared with the frontend, which signs short-lived tokens with it. Generate: openssl rand -hex 32
AUTH_TOKEN_SECRET=
DAILY_SESSION_CAP=5

# cloud only
PIPECAT_CLOUD_AGENT_NAME=digital-lluc
PIPECAT_CLOUD_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

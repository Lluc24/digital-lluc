# One file for both roots: `make dev-api` and `make dev-bot` each read the keys they need.
# local: in-memory daily cap, sessions on the `make dev-bot` runner (SmallWebRTC), recordings in ./recordings.
# cloud: Upstash daily cap, Pipecat Cloud agents, recordings in a private Vercel Blob store.
DEPLOYMENT=local

# --- session API ---
# Shared with the frontend, which signs short-lived tokens with it. Generate: openssl rand -hex 32
AUTH_TOKEN_SECRET=
DAILY_SESSION_CAP=5
# cloud only
PIPECAT_CLOUD_AGENT_NAME=digital-lluc
PIPECAT_CLOUD_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- bot ---
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
MAX_SESSION_SECONDS=600
IDLE_TIMEOUT_SECONDS=120
# cloud only
BLOB_READ_WRITE_TOKEN=

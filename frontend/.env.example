# Auth.js. Generate: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# The session API (backend/), and the secret it verifies our short-lived tokens with.
BACKEND_URL=http://localhost:8000
AUTH_TOKEN_SECRET=

# Local development only: act as this user without signing in. Refused on Vercel production.
LOCAL_DEV_USER_EMAIL=

# Sentry error monitoring; leave empty to keep Sentry off.
NEXT_PUBLIC_SENTRY_DSN=
